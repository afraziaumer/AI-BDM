# AI-BDM environment configuration template.
# Copy to .env and fill in real values. Never commit a real .env file.
#
# Each variable's accepted name(s), required/optional status, and purpose are
# documented inline. Several variables have both a legacy lowercase name and
# a canonical uppercase name -- the code checks the lowercase one first, then
# falls back to the uppercase one (see e.g. LLM_planner.py, phase1_pipeline.py,
# phase3/config.py). Only ONE of each pair needs to be set.

# --- LLM (required) ----------------------------------------------------------
# Groq API key. Powers every reasoning/planning stage of the pipeline: query
# intent planning (Step 1), the clarification-question layer, route
# selection's LLM fallback (Step 3), final reasoning (Step 4), relevance
# scoring's safety-net check, and query moderation. Without this, the
# pipeline cannot plan or execute a query at all -- there is currently no
# non-LLM query parser. Get a key at https://console.groq.com.
groq_llm_apikey1=replace_with_local_secret
# GROQ_API_KEY=replace_with_local_secret        # equivalent uppercase name

# The specific Groq models used are NOT configured via environment variables
# -- they're centrally selected in model_router.py's TASK_CONFIG (currently
# openai/gpt-oss-20b for lightweight tasks, openai/gpt-oss-120b for deeper
# reasoning, qwen/qwen3.6-27b as the universal fallback on primary-model
# failure). Change the model there, not via .env.

# --- Research/discovery providers (required for real leads) -----------------
# Serper.dev API key. Powers Step 2 discovery (Google web search for
# candidate businesses), Step 7 Google Maps/Places enrichment, and every
# review-platform "site:" discovery search in phase3/review_harvester.py.
# Without this, no businesses can be discovered and no Maps/review data can
# be found. Get a key at https://serper.dev.
serper=replace_with_local_secret
# SERPER_API_KEY=replace_with_local_secret      # equivalent uppercase name

# ScrapingBee API key (variable name is "zenrows" for historical reasons --
# this project migrated providers without renaming the variable; it is NOT a
# ZenRows key, confirmed against ScrapingBee's live API). Premium/JS-render
# fetch tier used when a native (unauthenticated) fetch is blocked
# (Cloudflare challenge, captcha, bot detection). Optional in the sense that
# native-only fetching still works without it, but a large fraction of real
# business sites will fail to scrape without this tier. Has a per-domain
# circuit breaker (opens after 2 consecutive failures) and is subject to
# your ScrapingBee plan's monthly call quota -- exhausting the quota degrades
# this tier pipeline-wide until the plan resets/upgrades (see
# docs/KNOWN_LIMITATIONS section on ScrapingBee quota).
zenrows=replace_with_local_secret
# ZENROWS_API_KEY=replace_with_local_secret     # equivalent uppercase name

# --- Optional enrichment providers -------------------------------------------
# Apify API token. Powers Google Maps review-TEXT harvesting (Google's own
# review panel is JS-virtualized and requires a signed-in session, which
# this project will not automate -- Apify's compass/Google-Maps-Reviews-
# Scraper actor is the only working path to real review text) and Reddit
# mention harvesting (trudax/reddit-scraper-lite actor -- Reddit blocks
# every direct fetch tier this project has). Without this, google_reviews
# and reddit platform checks silently return zero reviews/mentions; every
# other review platform is unaffected. Get a token at https://apify.com.
apify=replace_with_local_secret
# APIFY_API_TOKEN=replace_with_local_secret     # equivalent uppercase name

# GitHub personal access token. Powers github_enrichment.py's GitHub-presence
# lookup for a business. Optional -- degrades to "not found" without it.
GITHUB_TOKEN=replace_with_local_secret
# github_token=replace_with_local_secret        # equivalent lowercase name

# YouTube Data API key. Powers youtube_enrichment.py's channel lookup.
# Optional -- degrades to "not found" without it.
YOUTUBE_API_KEY=replace_with_local_secret
# youtube_api_key=replace_with_local_secret     # equivalent lowercase name

# --- Business Intelligence provider architecture (bi_providers.py) ----------
# Which BI provider chain is active. "google" (default) uses the free
# Google X-Ray (Serper site:-search based) provider for social/decision-maker
# discovery. "apify" is a registered placeholder only -- it makes no real API
# call yet (see APIFY_ENABLED below); do not set this to "apify" expecting
# real behavior.
BUSINESS_INTELLIGENCE_PROVIDER=google
# Enables the Google X-Ray provider. Default true; set false to disable
# Serper-based social/decision-maker discovery entirely.
GOOGLE_XRAY_ENABLED=true
# Enables the Apify BI provider -- currently a placeholder with no real
# implementation. Leave false (the default) until it's implemented.
APIFY_ENABLED=false
# Unused until APIFY_ENABLED's provider is real.
APIFY_API_KEY=
# Confidence floor (0-1) below which the BI manager falls back to the next
# provider in the chain instead of trusting a low-confidence match.
BI_CONFIDENCE_THRESHOLD=0.6

# --- Cloudflare R2 (storage_sync.py) -- optional, not required for the core
# pipeline to run ------------------------------------------------------------
# Which remote-storage backend is active. "r2" is the only registered
# provider today. Sync is treated purely as configured-or-not: missing
# credentials silently disable sync (folders stay local-only), never an
# error and never a blocker for the rest of the pipeline.
STORAGE_PROVIDER=r2
R2_SYNC_ENABLED=true
R2_ACCESS_KEY_ID=replace_with_local_secret
R2_SECRET_ACCESS_KEY=replace_with_local_secret
R2_BUCKET_NAME=replace_with_local_bucket_name
# Either R2_ACCOUNT_ID or R2_ENDPOINT is required if syncing is enabled (not
# both) -- R2_ENDPOINT takes precedence if both are set.
R2_ACCOUNT_ID=replace_with_local_account_id
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# --- Optional REST API wrapper (api.py) --------------------------------------
# api.py is a PARTIAL FastAPI wrapper -- it exposes only Step 1 (planning)
# and Step 2 (discovery/scraping) via POST /pipeline/run, plus read-only
# /leads endpoints. It does NOT expose Steps 3-8 (routing, final reasoning,
# tech-stack detection, RAG, Maps enrichment, accuracy check) that main.py's
# CLI entry point runs -- see docs/INTEGRATION_NOTES.md. Every endpoint
# except /health requires this key as an "X-API-Key" header. If unset, all
# protected endpoints fail closed (503), never run open.
AIBDM_API_KEY=replace_with_local_secret

# --- Storage/runtime paths (all optional -- sensible defaults shown) --------
# Root directory the local page/review/context store writes under.
STORAGE_ROOT=storage
# Path to the per-page crawl metadata index (CSV).
CRAWL_INDEX=crawl_index.csv
# Cache directory for tldextract's public-suffix-list download.
TLDEXTRACT_CACHE=.tldextract-cache

# --- Feature toggles ----------------------------------------------------------
# Enables Step 2's category-aware review/Reddit harvesting after a business
# commits. Default true; set false to skip it for a faster, cheaper run.
REVIEW_ENRICHMENT_ENABLED=true

# --- Not currently read by any code (documented for completeness only) -----
# LOG_LEVEL is not wired up -- logging verbosity is currently set via
# logging.basicConfig(level=...) calls in each script, not an environment
# variable. Do not rely on setting this.
